<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TDR.Tools.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Design System Palette Brushes (Single Source of Truth) -->
            <SolidColorBrush x:Key="BgPrimaryBrush">#0E0E0E</SolidColorBrush>
            <SolidColorBrush x:Key="BgPanelBrush">#141414</SolidColorBrush>
            <SolidColorBrush x:Key="BgInputBrush">#1A1A1A</SolidColorBrush>
            <SolidColorBrush x:Key="BorderSubtleBrush">#222222</SolidColorBrush>
            <SolidColorBrush x:Key="AccentBrush">#9EB6C8</SolidColorBrush>
            <SolidColorBrush x:Key="AccentSubtleBrush">#0AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ArchiveColorBrush">#D4A373</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimaryBrush">#C5C5C5</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondaryBrush">#6E6E6E</SolidColorBrush>
            <SolidColorBrush x:Key="SelectionHighlightBrush">#264F78</SolidColorBrush>

            <!-- Semantic Badge Brushes for Track Variants -->
            <SolidColorBrush x:Key="BadgeTrackBrush">#9EB6C8</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeMissionBrush">#D4A373</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeRaceBrush">#A8C3A8</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeTrackSubtleBrush">#209EB6C8</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeMissionSubtleBrush">#20D4A373</SolidColorBrush>
            <SolidColorBrush x:Key="BadgeRaceSubtleBrush">#20A8C3A8</SolidColorBrush>

            <!-- Vector StreamGeometries (Tabler-style Icons) -->
            <StreamGeometry x:Key="IconFolder">M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z</StreamGeometry>
            <StreamGeometry x:Key="IconArchive">M3 4a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4zm1 5v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9H4zm6 3h4v2h-4v-2z</StreamGeometry>
            <StreamGeometry x:Key="IconFile">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z M14 2v6h6</StreamGeometry>
            <StreamGeometry x:Key="IconGeometry">M12 2l9 5v10l-9 5l-9-5V7l9-5z M12 12l9-5 M12 12v10 M12 12L3 7</StreamGeometry>
            <StreamGeometry x:Key="IconParentDir">M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z M12 16v-6 M9 13l3-3 3 3</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Ultra-responsive, snappy ScrollBar hover & expansion transitions -->
        <Style Selector="ScrollBar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.06" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.05" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.05" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.05" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.05" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Windows 11 Explorer Navigation Toolbar Buttons -->
        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.06"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.06"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>
        <Style Selector="Button.nav-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="Button.nav-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.28"/>
        </Style>
    </Application.Styles>
</Application>