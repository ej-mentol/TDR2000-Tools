<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TDR.Tools.Views.ConfirmDeleteWindow"
        Title="Confirm Delete"
        Width="440" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource BgPrimaryBrush}">

    <Border Padding="20" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- HEADER / ICON -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                <PathIcon x:Name="DeleteIcon"
                          Data="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                          Width="26" Height="26"
                          Foreground="#E55353"
                          VerticalAlignment="Top"
                          Margin="0,2,0,0"/>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="HeaderTextBlock" Text="Confirm Deletion" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TargetItemTextBlock" Text="Are you sure you want to delete this item?" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="340"/>
                    <TextBlock x:Name="WarningTextBlock" Text="This action CANNOT be undone (bypasses Recycle Bin)." FontSize="10" FontWeight="SemiBold" Foreground="#FF6B6B" TextWrapping="Wrap" IsVisible="False"/>
                </StackPanel>
            </StackPanel>

            <!-- DONT ASK AGAIN CHECKBOX -->
            <CheckBox x:Name="DontAskCheckBox" Grid.Row="1" Content="Don't ask again" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="40,0,0,0"/>

            <!-- ACTIONS (Safe HIG Default: Cancel | Delete) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="DeleteButton" Content="Delete" Width="140" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#C53939" Foreground="White" FontWeight="SemiBold" FontSize="12" CornerRadius="4" Click="OnDeleteClick"/>
                <Button Content="Cancel" Width="90" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsDefault="True" IsCancel="True" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Click="OnCancelClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
