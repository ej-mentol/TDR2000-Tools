<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TDR.Tools.ViewModels"
        x:Class="TDR.Tools.Views.ConvertTrackWindow"
        x:DataType="vm:ConvertTrackModalViewModel"
        Title="{Binding TrackName, StringFormat='Export Track &amp; Map — {0}'}"
        Width="1020" Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP FULL-WIDTH OUTPUT DIRECTORY PATH BAR -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding TrackName, StringFormat='Export Destination Directory (Target output folder for level &quot;{0}&quot;):'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" Height="32" FontSize="12" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" CornerRadius="4"/>
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseOutputFolderClick" Height="32" Margin="8,0,0,0" Padding="14,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2-COLUMN MAIN WORKSPACE -->
        <Grid Grid.Row="1" ColumnDefinitions="420,16,*" Margin="20,16">
            
            <!-- LEFT COLUMN: SETTINGS & FORMAT CONTROLS -->
            <ScrollViewer Grid.Column="0" Padding="0,0,8,0" VerticalContentAlignment="Stretch">
                <Border VerticalAlignment="Stretch" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Export Formats &amp; Controls:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>

                        <CheckBox IsChecked="{Binding ExportObj}" Content="Wavefront 3D Scene (.OBJ / .MTL)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Generates a Wavefront 3D scene (.OBJ / .MTL) with track geometry baked into world coordinates."/>
                        
                        <CheckBox IsChecked="{Binding IncludeMovableProps}" IsEnabled="{Binding ExportObj}" Content="Bake Props, Signs &amp; Checkpoints into .OBJ / glTF" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="20,0,0,0" ToolTip.Tip="Bakes 3D models for arrows, signs, checkpoints, and dynamic mission props directly into world positions."/>

                        <CheckBox IsChecked="{Binding ExportGltf}" Content="Export glTF 2.0 Scene (.GLTF / .GLB)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Generates a glTF 2.0 scene (.GLTF / .GLB) with native object nodes for Blender, Unity, Unreal Engine &amp; Godot."/>

                        <CheckBox IsChecked="{Binding ExportPngTextures}" Content="Convert Textures to PNG (.png)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Decodes legacy TGA textures to modern .PNG format with full alpha transparency support."/>

                        <CheckBox IsChecked="{Binding ExportSceneJson}" Content="Export Scene Manifest (.JSON)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Generates a scene.json manifest containing world positions, rotations, and hierarchy references."/>

                        <CheckBox IsChecked="{Binding UseZeroOriginForJsonAssets}" IsEnabled="{Binding ExportSceneJson}" Content="Center Extracted Prefabs at Local Origin (0,0,0)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="20,0,0,0" ToolTip.Tip="Resets standalone exported model origins to (0,0,0) for engine instancing."/>

                        <CheckBox IsChecked="{Binding UseGrouping}" Content="Group Mesh Instances (g &lt;HieName&gt;)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Splits the combined .OBJ file into named object groups (g GroupName) for Blender filtering."/>

                        <CheckBox IsChecked="{Binding UseLocalCoords}" Content="Use Local Coordinates" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Exports mesh instances with local coordinates instead of applying world transforms."/>

                        <CheckBox IsChecked="{Binding EnableGroundSnap}" Content="Raycast Ground Snap Props to Surface" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Raycasts movable objects down onto terrain collision geometry using Möller–Trumbore raycasting."/>

                        <CheckBox IsChecked="{Binding VerboseLog}" Content="Verbose Pipeline Logging" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Logs detailed VFS hits and pipeline processing stages in session log."/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- RIGHT COLUMN: PRESET SELECTOR & HIERARCHICAL TREE INSPECTOR -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <!-- Preset Dropdown Selector Bar -->
                <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Preset / Layer Filter:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableVariants}" SelectedItem="{Binding SelectedVariant}" HorizontalAlignment="Stretch" Height="32" FontSize="12" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Search & Action Toolbar -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <TextBox Grid.Column="0" Text="{Binding SearchHieQuery, Mode=TwoWay}" Height="30" PlaceholderText="Filter supported track resources..." FontSize="11" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Select All" Click="OnSelectAllClick" Height="30" FontSize="11" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="Deselect All" Click="OnDeselectAllClick" Height="30" FontSize="11" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                </Grid>

                <!-- Full-Height Supported Resources Hierarchy Tree Card -->
                <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TreeView ItemsSource="{Binding HieTreeNodes}" Background="Transparent">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:HieNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Spacing="0">
                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="-32,0,0,3"
                                            IsVisible="{Binding ShowTopSeparator}"
                                            Opacity="0.5"/>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsVisible="{Binding IsVisible}" Content="{Binding Name}" Padding="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:HieNodeViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Margin" Value="0,1,0,1"/>
                            </Style>
                            <Style Selector="TreeView > TreeViewItem">
                                <Setter Property="Margin" Value="0,6,0,2"/>
                            </Style>
                        </TreeView.Styles>
                    </TreeView>
                </Border>
            </Grid>
        </Grid>

        <!-- FULL-WIDTH DIALOG FOOTER BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Export Track" Click="OnConfirmClick" IsDefault="True" Width="110" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="#0E0E0E" FontWeight="SemiBold" FontSize="12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"/>
                <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" Width="110" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
