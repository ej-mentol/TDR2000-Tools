<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TDR.Tools.ViewModels"
        x:Class="TDR.Tools.Views.ConvertTrackWindow"
        x:DataType="vm:ConvertTrackModalViewModel"
        Title="{Binding TrackName, StringFormat='Export Track &amp; Map — {0}'}"
        Width="1020" Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP FULL-WIDTH OUTPUT DIRECTORY PATH BAR -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding TrackName, StringFormat='Export Destination Directory (Target output folder for level &quot;{0}&quot;):'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" Height="30" FontSize="11" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" CornerRadius="4"/>
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseOutputFolderClick" Height="30" FontSize="11" Margin="8,0,0,0" Padding="12,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2-COLUMN MAIN WORKSPACE -->
        <Grid Grid.Row="1" ColumnDefinitions="420,16,*" Margin="20,16">
            
            <!-- LEFT COLUMN: SETTINGS & FORMAT CONTROLS -->
            <!-- LEFT COLUMN: STRUCTURED FORMAT CARDS & CONTROLS -->
            <ScrollViewer Grid.Column="0" Padding="0,0,8,0" VerticalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <!-- 1. GLTF 2.0 CARD -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding ExportGltf}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Content="glTF 2.0 Modern Scene (.GLTF / .GLB)" ToolTip.Tip="Generates a glTF 2.0 scene with native node hierarchy for Blender, Unity, Unreal Engine &amp; Godot."/>
                            <StackPanel Spacing="6" Margin="22,2,0,0" IsEnabled="{Binding ExportGltf}" Opacity="{Binding ExportGltf, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <CheckBox IsChecked="False" IsEnabled="False" Content="Rigged Pedestrian Skeletons (FK Armatures)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="[Temporarily Disabled] Exporting fully-rigged FK bone hierarchies for track pedestrians is temporarily disabled. Pedestrians will export as lightweight static meshes."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. WAVEFRONT OBJ CARD -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding ExportObj}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Content="Wavefront 3D Scene (.OBJ / .MTL)" ToolTip.Tip="Generates a Wavefront 3D scene (.OBJ / .MTL) with track geometry baked into world coordinates."/>
                            <StackPanel Spacing="6" Margin="22,2,0,0" IsEnabled="{Binding ExportObj}">
                                <CheckBox IsChecked="{Binding IncludeMovableProps}" Content="Bake Props, Signs &amp; Dynamic Checkpoints" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Bakes 3D models for arrows, signs, checkpoints, and dynamic mission props directly into world positions."/>
                                <CheckBox IsChecked="{Binding UseGrouping}" Content="Group Mesh Instances (g &lt;HieName&gt;)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Splits the combined .OBJ file into named object groups (g GroupName) for Blender filtering."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. TEXTURES & MATERIALS CARD (SHARED) -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Textures &amp; Materials (Shared):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <CheckBox IsChecked="{Binding ExportPngTextures}" Content="Convert Textures to Modern PNG (.png)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Decodes legacy TGA textures to modern .PNG format with full alpha transparency support (applies to both OBJ and glTF)."/>
                        </StackPanel>
                    </Border>

                    <!-- 4. SCENE JSON CARD -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <CheckBox IsChecked="{Binding ExportSceneJson}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Content="Scene Manifest &amp; Prefabs (.JSON)" ToolTip.Tip="Generates a scene.json manifest containing world positions, rotations, and hierarchy references."/>
                            <StackPanel Spacing="6" Margin="22,2,0,0" IsEnabled="{Binding ExportSceneJson}">
                                <CheckBox IsChecked="{Binding UseZeroOriginForJsonAssets}" Content="Center Extracted Prefabs at Local Origin (0,0,0)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Resets standalone exported model origins to (0,0,0) for engine instancing."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. ADVANCED PIPELINE OPTIONS CARD -->
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Advanced Pipeline Options:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <CheckBox IsChecked="{Binding UseLocalCoords}" Content="Use Local Coordinates" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Exports mesh instances with local coordinates instead of applying world transforms."/>
                            <CheckBox IsChecked="{Binding VerboseLog}" Content="Verbose Pipeline Diagnostics Logging" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="Logs detailed VFS hits and pipeline processing stages in session log."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: PRESET SELECTOR & HIERARCHICAL TREE INSPECTOR -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <!-- Row 0: Preset Selector & Expand/Collapse Toolbar -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableVariants}" SelectedItem="{Binding SelectedVariant}" HorizontalAlignment="Stretch" Height="30" FontSize="11" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Expand All" Click="OnExpandAllClick" Width="88" Height="30" FontSize="11" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="Collapse All" Click="OnCollapseAllClick" Width="88" Height="30" FontSize="11" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                </Grid>

                <!-- Row 1: Search & Selection Toolbar -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <TextBox Grid.Column="0" Text="{Binding SearchHieQuery, Mode=TwoWay}" Height="30" PlaceholderText="Filter supported track resources..." FontSize="11" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Select All" Click="OnSelectAllClick" Width="88" Height="30" FontSize="11" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="Deselect All" Click="OnDeselectAllClick" Width="88" Height="30" FontSize="11" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                </Grid>

                <!-- Full-Height Supported Resources Hierarchy Tree Card -->
                <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,10,16,10">
                    <TreeView ItemsSource="{Binding HieTreeNodes}" Background="Transparent" Margin="0,0,8,0">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Select All" Click="OnSelectAllClick"/>
                                <MenuItem Header="Deselect All" Click="OnDeselectAllClick"/>
                                <Separator/>
                                <MenuItem Header="Expand All" Click="OnExpandAllClick"/>
                                <MenuItem Header="Collapse All" Click="OnCollapseAllClick"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:HieNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Spacing="0" Margin="0,0,18,0">
                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="-32,0,0,3"
                                            IsVisible="{Binding ShowTopSeparator}"
                                            Opacity="0.5"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,8,0">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsThreeState="{Binding IsThreeState}"
                                                  IsVisible="{Binding IsVisible}"
                                                  ToolTip.Tip="{Binding VirtualPath}"
                                                  Padding="6,0,8,0"
                                                  FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Foreground="{Binding NodeForeground}"
                                                   FontWeight="{Binding NodeFontWeight}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding VirtualPath}"/>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding HasBadge}"
                                                Background="{Binding BadgeBackground}"
                                                CornerRadius="3"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeText}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding BadgeForeground}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:HieNodeViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="Padding" Value="2,1,18,1"/>
                                <Setter Property="Margin" Value="0,1,0,1"/>
                            </Style>
                            <Style Selector="TreeView > TreeViewItem">
                                <Setter Property="Margin" Value="0,6,0,2"/>
                            </Style>
                        </TreeView.Styles>
                    </TreeView>
                </Border>
            </Grid>
        </Grid>

        <!-- FULL-WIDTH DIALOG FOOTER BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Export Track" Click="OnConfirmClick" IsDefault="True" Width="110" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="#0E0E0E" FontWeight="SemiBold" FontSize="12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"/>
                <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" Width="110" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
